{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-form-coach",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  // Static site only: Cloudflare serves the Vite build as-is.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
